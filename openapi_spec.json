{
  "openapi": "3.1.0",
  "info": {
    "title": "Kaplan Meier Estimator API",
    "description": "Kaplan–Meier survival analysis and demonstration audit endpoints. No authentication is provided.",
    "version": "3.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Read demonstration metrics as JSON",
        "responses": {
          "200": {
            "description": "JSON metrics snapshot"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Query the deterministic mock supervisory adapter",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/kaplan-meier": {
      "post": {
        "summary": "Estimate Kaplan–Meier survival from event times and right-censoring",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "times",
                  "events"
                ],
                "properties": {
                  "times": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "Finite non-negative observed times"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ]
                    },
                    "description": "1 event, 0 censored"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event-time survival, CI, risk-set and hazard results"
          },
          "422": {
            "description": "Invalid or mismatched observation arrays"
          }
        }
      }
    },
    "/api/log-rank": {
      "post": {
        "summary": "Compute two-sample log-rank test",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "times1",
                  "events1",
                  "times2",
                  "events2"
                ],
                "properties": {
                  "times1": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "events1": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ]
                    }
                  },
                  "times2": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "events2": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chi-square statistic, two-sided p-value and signed z-score"
          },
          "422": {
            "description": "Invalid observation arrays"
          }
        }
      }
    }
  }
}
